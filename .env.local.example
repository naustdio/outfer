# Local Supabase dev environment (via `supabase start`, Docker).
# Copy this to .env.local and never commit .env.local -- it's gitignored.
# Regenerate anytime with: supabase status -o env

SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres
SUPABASE_STUDIO_URL=http://127.0.0.1:56323

# When this app ships to production, replace the block above with the values
# from the real hosted Supabase project (Project Settings > API), and run:
#   supabase link --project-ref <your-project-ref>
#   supabase db push
# to apply every migration under supabase/migrations/ to production.

# IMPORTANT (tasks.md 12.7): the `rls` Vitest project (tests/rls/) SILENTLY
# SKIPS instead of failing when SUPABASE_URL/SUPABASE_ANON_KEY/
# SUPABASE_SERVICE_ROLE_KEY are unset -- see tests/rls/_env.js. CI MUST set
# these or the entire RLS/security-posture suite never runs. Run
# SUPABASE_URL=... SUPABASE_ANON_KEY=... SUPABASE_SERVICE_ROLE_KEY=... npx vitest run tests/rls
# locally before every merge that touches supabase/migrations/.
